# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
APP_URL=https://your-app.onrender.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string_use_openssl_rand
# REQUIRED — must be different from JWT_SECRET (use: openssl rand -hex 32)
JWT_REFRESH_SECRET=another_64_char_random_string_different_from_above

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FULL_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MODEL=claude-haiku-4-5-20251001

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ── Plan Limits ───────────────────────────────────────────────────────────────
FREE_WORD_LIMIT=500
STARTER_WORD_LIMIT=5000
PRO_WORD_LIMIT=50000

# ── Plan Prices (for admin revenue dashboard) ─────────────────────────────────
PLAN_PRICE_STARTER=29
PLAN_PRICE_PRO=79
PLAN_PRICE_ENTERPRISE=299

# ── Email Provider ────────────────────────────────────────────────────────────
# Set to "true" once your email sending code is wired in (auth.controller.js forgotPassword)
EMAIL_PROVIDER_CONFIGURED=false

# ── Cron Instance Guard ───────────────────────────────────────────────────────
# On multi-instance deployments, only the instance with CRON_INSTANCE_ID=1 runs cron jobs.
# Leave unset on single-instance deployments.
# CRON_INSTANCE_ID=1
